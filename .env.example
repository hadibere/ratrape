# Copier ce fichier en .env.local, qui n'est jamais versionné.

# Postgres (Supabase) — Project Settings > Database > Connection string.
# Prendre « Transaction pooler » (port 6543) : c'est le mode adapté à Vercel.
# Remplacer [YOUR-PASSWORD] par le mot de passe choisi à la création du projet.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Migrations Drizzle — Project Settings > Database > Connection string > « Direct connection ».
# Le pooler refuse les commandes de schéma, il faut la connexion directe (port 5432).
DIRECT_URL=

# Stockage des photos — bouton Connect, ou Project Settings > API Keys.
# NEXT_PUBLIC_SUPABASE_URL ressemble à https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY est la clé « Secret », qui commence par sb_secret_
# (anciennement service_role). Elle contourne toutes les règles d'accès et ne
# doit jamais se retrouver dans le navigateur. Ne pas confondre avec la clé
# « Publishable », qui commence par sb_publishable_ et n'a aucun droit d'écriture.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Domaine public affiché dans le lien de gestion. Sans lui, « ratrape.fr » est utilisé.
NEXT_PUBLIC_SITE_URL=

# Développement uniquement : autorise les dépôts hors de la commune couverte.
# Sans cette variable, seules les positions dans Maisons-Laffitte sont acceptées.
NEXT_PUBLIC_RATRAPE_ANYWHERE=
