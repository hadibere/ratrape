# Copier ce fichier en .env.local, qui n'est jamais versionné.

# Postgres (Supabase) — Project Settings > Database > Connection string.
# Prendre « Transaction pooler » (port 6543) : c'est le mode adapté à Vercel.
# Remplacer [YOUR-PASSWORD] par le mot de passe choisi à la création du projet.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Migrations Drizzle — Project Settings > Database > Connection string > « Direct connection ».
# Le pooler refuse les commandes de schéma, il faut la connexion directe (port 5432).
DIRECT_URL=

# Stockage des photos (à brancher à l'étape suivante).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Domaine public affiché dans le lien de gestion. Sans lui, « ratrape.fr » est utilisé.
NEXT_PUBLIC_SITE_URL=
